---
import Icon from './Icon.astro';
import { apps } from '../data/apps';

const navLinks = [
  { label: 'Home',        href: '/'              },
  { label: 'All Apps',    href: '/app'           },
  { label: 'Promo Codes', href: '/promo-codes'   },
  { label: 'Blog',        href: '/blog'          },
  { label: 'Be an Agent', href: '/become-agent'   },
];

const currentPath = Astro.url.pathname;

const tickerItems = [
  { icon: 'gift',      text: 'Daily Promo Codes Updated 3x — AM, PM & Evening' },
  { icon: 'banknotes', text: 'Welcome Bonus Available on First Deposit'         },
  { icon: 'gamepad',   text: `${apps.length} Yono Apps Available — Free APK Download` },
  { icon: 'currency',  text: 'Real Cash Prizes — Withdraw Instantly via UPI'    },
  { icon: 'trophy',    text: 'New Games Added Regularly — Stay Updated'         },
];
---

<!-- ── Announcement Ticker ───────────────────────────────────── -->
<div class="relative overflow-hidden bg-gradient-to-r from-yellow-500 via-amber-400 to-orange-500 py-1.5">
  <!-- Fade edges -->
  <div class="absolute left-0 top-0 bottom-0 w-12 bg-gradient-to-r from-yellow-500 to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-12 bg-gradient-to-l from-orange-500 to-transparent z-10 pointer-events-none"></div>

  <div class="flex whitespace-nowrap ticker-inner">
    {[...tickerItems, ...tickerItems].map(item => (
      <span class="px-8 shrink-0 flex items-center gap-2 text-gray-950 text-xs font-bold tracking-wide">
        <Icon name={item.icon} class="w-3.5 h-3.5 shrink-0" />
        {item.text}
      </span>
    ))}
  </div>
</div>

<style>
  .ticker-inner {
    animation: ticker-scroll 32s linear infinite;
    width: max-content;
  }
  .ticker-inner:hover { animation-play-state: paused; }
  @keyframes ticker-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

<!-- ── Header ────────────────────────────────────────────────── -->
<header class="sticky top-0 z-50 transition-all duration-300" id="site-header">
  <!-- Glass panel -->
  <div class="absolute inset-0 bg-[#05070A]/85 backdrop-blur-2xl"></div>
  <!-- Gradient bottom line -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-yellow-400/30 to-transparent"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <div class="relative">
          <div class="absolute inset-0 bg-yellow-400/30 rounded-xl blur-md group-hover:blur-lg group-hover:bg-yellow-400/50 transition-all duration-300"></div>
          <img src="/logo.png" alt="YonoLink" class="relative w-10 h-10 rounded-xl object-cover" />
        </div>
        <span class="text-lg font-black tracking-tight">
          <span class="text-gold">Yono</span><span class="text-white">Link</span><span class="text-gray-600">.co</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map(link => {
          const active = link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`relative px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-200 group ${
                active
                  ? 'text-yellow-400'
                  : 'text-gray-400 hover:text-white'
              }`}
            >
              {active && (
                <span class="absolute inset-0 bg-yellow-400/8 rounded-xl border border-yellow-400/15"></span>
              )}
              <span class="relative">{link.label}</span>
              {!active && (
                <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-0 group-hover:w-4/5 h-px bg-gradient-to-r from-yellow-400 to-orange-500 transition-all duration-300 rounded-full"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- CTA + mobile toggle -->
      <div class="flex items-center gap-3">
        <a
          href="/app"
          class="hidden md:inline-flex items-center gap-2 btn-shimmer btn-glow bg-gradient-to-r from-yellow-400 via-amber-400 to-orange-500 text-gray-950 font-black text-sm px-5 py-2.5 rounded-xl"
        >
          <Icon name="gamepad" class="w-4 h-4" />
          Browse All Apps
        </a>

        <!-- Mobile toggle -->
        <button
          id="mobile-menu-btn"
          class="md:hidden relative w-10 h-10 glass border border-white/10 rounded-xl flex items-center justify-center text-gray-300 hover:text-white transition-colors"
          aria-label="Toggle menu"
        >
          <span id="menu-icon-open">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </span>
          <span id="menu-icon-close" class="hidden">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </span>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 pt-2">
      <div class="glass border border-white/5 rounded-2xl p-3 space-y-1">
        {navLinks.map(link => {
          const active = link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all ${
                active
                  ? 'bg-yellow-400/10 text-yellow-400 border border-yellow-400/15'
                  : 'text-gray-300 hover:text-white hover:bg-white/5'
              }`}
            >
              {link.label}
              {active && <span class="ml-auto w-1.5 h-1.5 rounded-full bg-yellow-400"></span>}
            </a>
          );
        })}
        <a
          href="/app"
          class="flex items-center justify-center gap-2 btn-shimmer bg-gradient-to-r from-yellow-400 to-orange-500 text-gray-950 font-black text-sm px-4 py-3 rounded-xl mt-2"
        >
          <Icon name="gamepad" class="w-4 h-4" />
          Browse All Apps
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn   = document.getElementById('mobile-menu-btn');
  const menu  = document.getElementById('mobile-menu');
  const open  = document.getElementById('menu-icon-open');
  const close = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    open?.classList.toggle('hidden', !hidden);
    close?.classList.toggle('hidden', !!hidden);
  });

  // Scroll shadow
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('shadow-xl', window.scrollY > 10);
  }, { passive: true });
</script>
