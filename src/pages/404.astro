---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="404 — Page Not Found on YonoLink"
  description="The page you're looking for doesn't exist or has been moved. Browse all 54 Yono games, daily promo codes, APK download guides and expert tips on YonoLink."
  noindex={true}
>
  <Header slot="header" />

  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden hero-mesh py-20">
    <!-- Background blobs -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-yellow-400/6 rounded-full blur-[120px] animate-float-slow"></div>
      <div class="absolute bottom-0 left-1/4 w-[400px] h-[300px] bg-violet-600/6 rounded-full blur-[100px]"></div>
      <div class="absolute inset-0 dot-grid opacity-[0.025]"></div>
    </div>

    <div class="relative max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

      <!-- 404 number -->
      <div class="font-display font-black text-[120px] sm:text-[160px] leading-none text-gold opacity-15 select-none mb-0 -mb-4">
        404
      </div>

      <!-- Icon -->
      <div class="w-20 h-20 mx-auto rounded-3xl glass-gold border border-yellow-400/20 flex items-center justify-center mb-6 animate-pulse-glow">
        <Icon name="warning" class="w-9 h-9 text-yellow-400" />
      </div>

      <!-- Heading -->
      <h1 class="font-display font-black text-3xl sm:text-4xl text-white mb-4">
        Page Not Found
      </h1>
      <p class="text-gray-400 text-base sm:text-lg leading-relaxed mb-10 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved. Head back and explore all Yono games.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a
          href="/"
          class="btn-shimmer btn-glow w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-yellow-400 via-amber-400 to-orange-500 text-gray-950 font-black text-base px-8 py-4 rounded-2xl"
        >
          <Icon name="arrow-right" class="w-5 h-5 rotate-180" />
          Back to Home
        </a>
        <a
          href="/games"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 glass border border-white/10 hover:border-yellow-400/30 text-white font-bold text-base px-8 py-4 rounded-2xl transition-all duration-200"
        >
          <Icon name="gamepad" class="w-5 h-5 text-yellow-400" />
          Browse All Games
        </a>
      </div>

      <!-- Quick links -->
      <div class="glass border border-white/5 rounded-2xl p-6">
        <p class="text-gray-500 text-xs uppercase tracking-widest font-bold mb-4">Quick Links</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          {[
            { label: 'All Games',    href: '/games'        },
            { label: 'Promo Codes',  href: '/promo-codes'  },
            { label: 'Be an Agent',  href: '/become-agent' },
            { label: 'Blog',         href: '/blog'         },
            { label: 'About Us',     href: '/about'        },
            { label: 'Contact',      href: '/contact'      },
          ].map(link => (
            <a
              href={link.href}
              class="text-sm text-gray-400 hover:text-yellow-400 glass border border-white/8 hover:border-yellow-400/25 px-4 py-2 rounded-xl transition-all duration-200"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <Footer />
</BaseLayout>
