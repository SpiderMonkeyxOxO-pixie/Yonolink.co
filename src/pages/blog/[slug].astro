---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/published';
import { apps, appsBySlug } from '../../data/apps';

export async function getStaticPaths() {
  const posts = await getCollection('blog', isPublished);
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, description, pubDate, author, tags, image } = post.data;

const date = new Date(pubDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const isoDate = new Date(pubDate).toISOString();

// Reading time
const wordCount = post.body.split(/\s+/).length;
const readTime = Math.max(1, Math.ceil(wordCount / 200));

// Table of Contents — H2 headings only
const tocHeadings = headings.filter(h => h.depth === 2);

// Related posts (same tags, different slug)
const allPosts = await getCollection('blog', isPublished);
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug && p.data.tags.some(t => tags.includes(t)))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

// Similar games — top rated apps
const similarApps = [...apps].sort((a, b) => b.rating - a.rating).slice(0, 6);

// Share URLs
const pageUrl = `https://yonolink.co/blog/${post.slug}`;
const shareText = encodeURIComponent(`${title} — YonoLink.co`);
const whatsappUrl = `https://wa.me/?text=${shareText}%20${encodeURIComponent(pageUrl)}`;
const telegramUrl = `https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${shareText}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yonolink.co' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://yonolink.co/blog' },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: image ? `https://yonolink.co${image}` : 'https://yonolink.co/og-default.jpg',
  url: pageUrl,
  datePublished: isoDate,
  dateModified: isoDate,
  author: { '@type': 'Person', name: author, url: 'https://yonolink.co' },
  publisher: {
    '@type': 'Organization',
    name: 'YonoLink.co',
    url: 'https://yonolink.co',
    logo: { '@type': 'ImageObject', url: 'https://yonolink.co/favicon.svg' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  keywords: tags.join(', '),
  wordCount,
  timeRequired: `PT${readTime}M`,
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  schema={[breadcrumbSchema, articleSchema]}
>
  <Header slot="header" />

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <div class="w-full bg-gradient-to-b from-gray-900 to-gray-950 border-b border-gray-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-0">

      <!-- Breadcrumb -->
      <nav class="text-xs text-gray-500 mb-5 flex items-center gap-1.5 flex-wrap">
        <a href="/" class="hover:text-yellow-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-yellow-400 transition-colors">Blog</a>
        <span>/</span>
        <span class="text-gray-400 line-clamp-1">{title}</span>
      </nav>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.slice(0, 3).map(tag => (
          <span class="text-xs bg-yellow-400/10 text-yellow-400 border border-yellow-400/20 px-2.5 py-0.5 rounded-full font-medium">#{tag}</span>
        ))}
      </div>

      <!-- Title -->
      <h1 class="text-2xl sm:text-4xl font-black text-white mb-4 leading-tight max-w-3xl">{title}</h1>

      <!-- Meta bar -->
      <div class="flex items-center gap-3 sm:gap-5 text-sm text-gray-500 pb-6 flex-wrap">
        <span class="flex items-center gap-2">
          <img src="/logos/Yonolink-Team.png" alt="YonoLink Team" class="w-7 h-7 rounded-full object-cover" />
          <span class="font-medium text-gray-400">{author}</span>
        </span>
        <span class="text-gray-700">·</span>
        <time datetime={isoDate} class="text-gray-500">{date}</time>
        <span class="text-gray-700">·</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          {readTime} min read
        </span>
        <span class="text-gray-700 hidden sm:inline">·</span>
        <!-- Social share -->
        <div class="flex items-center gap-2 ml-auto sm:ml-0">
          <span class="text-xs text-gray-600 hidden sm:inline">Share:</span>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"
            class="flex items-center gap-1.5 bg-green-500/10 hover:bg-green-500/20 text-green-400 border border-green-500/20 text-xs font-semibold px-3 py-1.5 rounded-full transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a href={telegramUrl} target="_blank" rel="noopener noreferrer"
            class="flex items-center gap-1.5 bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 border border-blue-500/20 text-xs font-semibold px-3 py-1.5 rounded-full transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            Telegram
          </a>
        </div>
      </div>
    </div>

    <!-- Full-width hero image -->
    {image && (
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-t-2xl overflow-hidden border border-gray-800 border-b-0">
          <img src={image} alt={title} class="w-full h-auto block" loading="eager" />
        </div>
      </div>
    )}
    {!image && (
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="h-3 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-t-full"></div>
      </div>
    )}
  </div>

  <!-- ── MAIN CONTENT ───────────────────────────────────────────────────────── -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">

      <!-- ── ARTICLE ──────────────────────────────────────────────────────── -->
      <article class="lg:col-span-2 min-w-0">

        <!-- Promo code highlight box -->
        <div class="flex items-center gap-4 bg-gradient-to-r from-yellow-400/10 to-orange-500/10 border border-yellow-400/20 rounded-2xl px-5 py-4 mb-8">
          <div class="shrink-0 w-10 h-10 bg-yellow-400/20 rounded-xl flex items-center justify-center">
            <Icon name="gift" class="w-5 h-5 text-yellow-400" />
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-xs text-gray-400 mb-0.5">New users — welcome bonus on first deposit</p>
            <p class="text-white font-bold text-sm">Available on all 54 Yono apps</p>
          </div>
          <a href="/promo-codes" class="shrink-0 bg-yellow-400 text-gray-950 font-black text-xs px-4 py-2 rounded-xl hover:opacity-90 transition-opacity whitespace-nowrap hidden sm:block">
            Get Code →
          </a>
        </div>

        <!-- Article body -->
        <div class="prose prose-invert prose-yellow max-w-none
          prose-headings:font-black prose-headings:text-white prose-headings:scroll-mt-24
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-gray-800
          prose-h3:text-lg prose-h3:mt-6 prose-h3:mb-3
          prose-p:text-gray-400 prose-p:leading-relaxed prose-p:my-4
          prose-a:text-yellow-400 prose-a:no-underline hover:prose-a:underline prose-a:font-medium
          prose-strong:text-white prose-strong:font-bold
          prose-code:text-yellow-400 prose-code:bg-gray-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono prose-code:before:content-none prose-code:after:content-none
          prose-ul:text-gray-400 prose-ol:text-gray-400 prose-li:my-1
          prose-li:marker:text-yellow-400
          prose-table:text-sm prose-th:text-white prose-th:bg-gray-900 prose-th:border-gray-700 prose-th:px-4 prose-th:py-3 prose-td:text-gray-400 prose-td:border-gray-800 prose-td:px-4 prose-td:py-2.5
          prose-blockquote:not-italic prose-blockquote:border-l-4 prose-blockquote:border-yellow-400 prose-blockquote:bg-yellow-400/5 prose-blockquote:rounded-r-xl prose-blockquote:px-5 prose-blockquote:py-4 prose-blockquote:my-6 prose-blockquote:text-gray-300
          prose-hr:border-gray-800 prose-hr:my-8
          prose-img:rounded-xl prose-img:border prose-img:border-gray-800
        ">
          <Content />
        </div>

        <!-- ── SIMILAR GAMES SECTION ──────────────────────────────────────── -->
        <div class="mt-12 pt-8 border-t border-gray-800">
          <h2 class="text-xl font-black text-white mb-1">Similar Yono Games</h2>
          <p class="text-gray-500 text-sm mb-6">Top-rated apps across the Yono ecosystem</p>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
            {similarApps.map(app => (
              <a href={`/app/${app.slug}`}
                class="group flex items-center gap-3 bg-gray-900 border border-gray-800 rounded-xl p-3 hover:border-yellow-400/30 transition-all">
                <div class="w-12 h-12 shrink-0 rounded-xl overflow-hidden bg-gray-800 border border-gray-700 group-hover:border-yellow-400/30 transition-colors">
                  <img src={app.logo} alt={app.name} class="w-full h-full object-contain p-0.5" loading="lazy" />
                </div>
                <div class="min-w-0">
                  <div class="text-xs font-bold text-white group-hover:text-yellow-400 transition-colors truncate leading-tight mb-0.5">{app.name}</div>
                  <div class="text-[10px] text-gray-500">{app.category}</div>
                  <div class="flex items-center gap-0.5 mt-0.5">
                    <svg class="w-2.5 h-2.5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    <span class="text-[10px] text-gray-400 font-medium">{app.rating}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>

          <div class="text-center mt-5">
            <a href="/games" class="inline-flex items-center gap-2 text-yellow-400 text-sm font-semibold hover:text-yellow-300 transition-colors">
              View All {apps.length} Apps <Icon name="arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- ── BOTTOM TAGS ─────────────────────────────────────────────────── -->
        <div class="mt-8 pt-6 border-t border-gray-800 flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="text-xs bg-gray-800 text-gray-500 px-3 py-1 rounded-full">#{tag}</span>
          ))}
        </div>

        <!-- ── CTA BOX ─────────────────────────────────────────────────────── -->
        <div class="mt-6 bg-gradient-to-r from-yellow-400/10 to-orange-500/10 border border-yellow-400/20 rounded-2xl p-6">
          <div class="flex flex-col sm:flex-row items-center gap-4">
            <div class="flex-1 text-center sm:text-left">
              <h3 class="text-lg font-black text-white mb-1">Ready to play Yono?</h3>
              <p class="text-gray-400 text-sm">Grab your welcome bonus code before your first deposit — new users get a bonus on every Yono app.</p>
            </div>
            <div class="flex flex-col gap-2 shrink-0 w-full sm:w-auto">
              <a href="/promo-codes" class="bg-gradient-to-r from-yellow-400 to-orange-500 text-gray-950 font-black px-6 py-2.5 rounded-xl hover:opacity-90 transition-opacity text-sm text-center">
                Get Promo Codes
              </a>
              <a href="/games" class="bg-gray-800 border border-gray-700 text-white font-semibold px-6 py-2.5 rounded-xl hover:bg-gray-700 transition-colors text-sm text-center">
                Browse Games
              </a>
            </div>
          </div>
        </div>

        <!-- Bottom share -->
        <div class="mt-6 flex items-center gap-3 justify-center sm:justify-start">
          <span class="text-xs text-gray-600">Share this article:</span>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer"
            class="flex items-center gap-1.5 bg-green-500/10 hover:bg-green-500/20 text-green-400 border border-green-500/20 text-xs font-semibold px-3 py-1.5 rounded-full transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
          <a href={telegramUrl} target="_blank" rel="noopener noreferrer"
            class="flex items-center gap-1.5 bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 border border-blue-500/20 text-xs font-semibold px-3 py-1.5 rounded-full transition-colors">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
            Telegram
          </a>
        </div>

        <!-- Back link -->
        <div class="mt-6 text-center sm:text-left">
          <a href="/blog" class="inline-flex items-center gap-2 text-gray-500 hover:text-white text-sm transition-colors">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
            Back to all articles
          </a>
        </div>

      </article>

      <!-- ── SIDEBAR ───────────────────────────────────────────────────────── -->
      <aside class="space-y-5">
        <div class="lg:sticky lg:top-24 space-y-5">

          <!-- Table of Contents -->
          {tocHeadings.length > 2 && (
            <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5">
              <h3 class="font-bold text-white text-sm mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0ZM3.75 12h.007v.008H3.75V12Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm-.375 5.25h.007v.008H3.75v-.008Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/></svg>
                Table of Contents
              </h3>
              <nav class="space-y-0.5">
                {tocHeadings.map((h, i) => (
                  <a
                    href={`#${h.slug}`}
                    class="flex items-start gap-2 text-xs text-gray-400 hover:text-yellow-400 py-1.5 px-2 rounded-lg hover:bg-yellow-400/5 transition-all group"
                  >
                    <span class="text-gray-700 group-hover:text-yellow-400/50 transition-colors shrink-0 font-mono text-[10px] mt-0.5">{String(i + 1).padStart(2, '0')}</span>
                    <span class="leading-tight">{h.text}</span>
                  </a>
                ))}
              </nav>
            </div>
          )}

          <!-- Promo callout -->
          <div class="bg-gradient-to-br from-yellow-400/10 to-orange-500/10 border border-yellow-400/20 rounded-2xl p-5 text-center">
            <div class="w-10 h-10 bg-yellow-400/20 rounded-xl flex items-center justify-center mx-auto mb-3">
              <Icon name="gift" class="w-5 h-5 text-yellow-400" />
            </div>
            <p class="text-white font-bold text-sm mb-1">Welcome Bonus Available</p>
            <p class="text-xs text-gray-400 mb-4">New users get a welcome bonus on their first deposit on any Yono app. Get the code before you register.</p>
            <a href="/promo-codes" class="block w-full bg-gradient-to-r from-yellow-400 to-orange-500 text-gray-950 font-black text-xs py-2.5 rounded-xl hover:opacity-90 transition-opacity">
              Get Your Code →
            </a>
          </div>

          <!-- Related articles -->
          {relatedPosts.length > 0 && (
            <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5">
              <h3 class="font-bold text-white text-sm mb-4 flex items-center gap-2">
                <Icon name="newspaper" class="w-4 h-4 text-yellow-400" />
                Related Articles
              </h3>
              <div class="space-y-3">
                {relatedPosts.map(p => (
                  <a href={`/blog/${p.slug}`} class="block group">
                    <div class="text-xs font-semibold text-gray-300 group-hover:text-yellow-400 transition-colors leading-snug mb-1 line-clamp-2">
                      {p.data.title}
                    </div>
                    <div class="text-[11px] text-gray-600">
                      {new Date(p.data.pubDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Quick links -->
          <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5">
            <h3 class="font-bold text-white text-sm mb-3">Quick Links</h3>
            <div class="space-y-2">
              {[
                { label: 'Latest Promo Codes', href: '/promo-codes', icon: 'gift' },
                { label: 'All 56 Yono Apps', href: '/games', icon: 'gamepad' },
                { label: 'Yono Rummy', href: '/app/yono-rummy', icon: 'arrow-right' },
                { label: 'Yono 777', href: '/app/yono-777', icon: 'arrow-right' },
                { label: 'Yono Games', href: '/app/yono-games', icon: 'arrow-right' },
              ].map(link => (
                <a href={link.href} class="flex items-center gap-2 text-xs text-gray-400 hover:text-yellow-400 transition-colors group py-0.5">
                  <Icon name={link.icon} class="w-3.5 h-3.5 text-gray-600 group-hover:text-yellow-400 transition-colors shrink-0" />
                  {link.label}
                </a>
              ))}
            </div>
          </div>

        </div>
      </aside>
    </div>

    <!-- ── RELATED POSTS BOTTOM GRID ─────────────────────────────────────── -->
    {relatedPosts.length > 0 && (
      <div class="mt-16 pt-10 border-t border-gray-800">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-black text-white">More Articles</h2>
          <a href="/blog" class="text-yellow-400 text-sm font-semibold hover:text-yellow-300 transition-colors">View All →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
          {relatedPosts.map(p => (
            <a href={`/blog/${p.slug}`} class="group bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden hover:border-yellow-400/30 transition-all">
              <div class="h-36 bg-gradient-to-br from-gray-800 to-gray-900 flex items-center justify-center overflow-hidden">
                {p.data.image ? (
                  <img src={p.data.image} alt={p.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                ) : (
                  <Icon name="newspaper" class="w-12 h-12 text-gray-600" />
                )}
              </div>
              <div class="p-4">
                <div class="flex flex-wrap gap-1 mb-2">
                  {p.data.tags.slice(0, 1).map(tag => (
                    <span class="text-[10px] bg-yellow-400/10 text-yellow-400 px-2 py-0.5 rounded-full">{tag}</span>
                  ))}
                </div>
                <h3 class="text-sm font-bold text-white group-hover:text-yellow-400 transition-colors leading-snug mb-2 line-clamp-2">{p.data.title}</h3>
                <div class="text-[11px] text-gray-600">
                  {new Date(p.data.pubDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <Footer slot="footer" />
</BaseLayout>
