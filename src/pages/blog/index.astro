---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const featured = sorted.find(p => p.data.featured);
const rest = sorted.filter(p => p.slug !== featured?.slug);

// All unique tags across posts
const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))].slice(0, 10);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yonolink.co' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://yonolink.co/blog' },
  ],
};

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'YonoLink Blog — All Yono Game Guides & Tips',
  url: 'https://yonolink.co/blog',
  description: 'Expert guides, winning strategies, and tips for all Yono games.',
  blogPost: allPosts.map(p => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    url: `https://yonolink.co/blog/${p.slug}`,
    datePublished: p.data.pubDate,
    author: { '@type': 'Person', name: p.data.author },
    keywords: p.data.tags.join(', '),
  })),
};
---

<BaseLayout
  title="All Yono Game Blog — Tips, Guides & Strategies 2026"
  description={`${allPosts.length} expert guides and strategies for all Yono game. Learn how to win at Rummy, Teen Patti, Ludo, Poker, Aviator and more. Updated weekly.`}
  schema={[breadcrumbSchema, blogListSchema]}
>
  <Header slot="header" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-yellow-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-gray-300">Blog</span>
    </nav>

    <!-- Page header -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 bg-yellow-400/10 border border-yellow-400/20 text-yellow-400 text-sm font-medium px-4 py-1.5 rounded-full mb-4">
        <Icon name="newspaper" class="w-4 h-4" /> {allPosts.length} Articles & Guides
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white mb-3">
        All Yono Game — Blog & Strategy Guides
      </h1>
      <p class="text-gray-400 text-lg max-w-3xl">
        Expert tips, download guides, promo code roundups, and winning strategies for every Yono game. Updated weekly by the YonoLink team.
      </p>
    </div>

    <!-- Tag cloud -->
    <div class="flex flex-wrap gap-2 mb-10">
      <span class="text-gray-600 text-sm self-center mr-1">Browse by topic:</span>
      {allTags.map(tag => (
        <span class="bg-gray-800 hover:bg-gray-700 text-gray-400 hover:text-white text-xs px-3 py-1 rounded-full cursor-default transition-colors">
          #{tag}
        </span>
      ))}
    </div>

    <!-- Featured post -->
    {featured && (
      <a
        href={`/blog/${featured.slug}`}
        class="group block bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden hover:border-yellow-400/40 transition-all mb-12"
      >
        <div class="grid grid-cols-1 lg:grid-cols-2">
          <div class="bg-gray-900 flex items-center justify-center overflow-hidden min-h-[220px] lg:min-h-full">
            {featured.data.image ? (
              <img src={featured.data.image} alt={featured.data.title} class="w-full h-auto max-h-[380px] object-contain group-hover:scale-[1.02] transition-transform duration-500" loading="eager" />
            ) : (
              <Icon name="newspaper" class="w-20 h-20 text-gray-600" />
            )}
          </div>
          <div class="p-8 flex flex-col justify-center">
            <div class="inline-flex items-center gap-2 bg-yellow-400/10 border border-yellow-400/20 text-yellow-400 text-xs font-bold px-3 py-1 rounded-full w-fit mb-4">
              <Icon name="star" class="w-3.5 h-3.5" /> Featured Guide
            </div>
            <h2 class="text-2xl font-black text-white group-hover:text-yellow-400 transition-colors mb-3 leading-snug">
              {featured.data.title}
            </h2>
            <p class="text-gray-400 mb-5 leading-relaxed">{featured.data.description}</p>
            <div class="flex flex-wrap gap-1.5 mb-5">
              {featured.data.tags.slice(0, 3).map(tag => (
                <span class="bg-gray-800 text-gray-500 text-xs px-2.5 py-0.5 rounded-full">#{tag}</span>
              ))}
            </div>
            <div class="flex items-center justify-between text-sm text-gray-500">
              <span class="flex items-center gap-1.5">
                <img src="/logos/Yonolink-Team.png" alt="YonoLink Team" class="w-6 h-6 rounded-full object-cover" />
                {featured.data.author}
              </span>
              <span>{new Date(featured.data.pubDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
            </div>
          </div>
        </div>
      </a>
    )}

    <!-- Latest posts grid -->
    <div class="mb-4 flex items-center gap-3">
      <h2 class="text-lg font-bold text-white">Latest Articles</h2>
      <span class="text-gray-600 text-sm">{rest.length} posts</span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5 mb-12">
      {rest.map(post => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          slug={post.slug}
          pubDate={post.data.pubDate}
          author={post.data.author}
          tags={post.data.tags}
          image={post.data.image}
          featured={post.data.featured}
        />
      ))}
    </div>

    <!-- SEO content block -->
    <div class="max-w-3xl border-t border-gray-800 pt-10">
      <h2 class="text-xl font-black text-white mb-4">Yono Game Guides & Resources</h2>
      <p class="text-gray-400 text-sm leading-relaxed mb-3">
        The YonoLink blog is your go-to resource for mastering <strong class="text-white">all Yono game</strong> content — from beginner download guides to advanced tournament strategies. Our team plays every game and writes from real experience.
      </p>
      <p class="text-gray-400 text-sm leading-relaxed">
        Looking for promo codes instead? Visit our <a href="/promo-codes" class="text-yellow-400 hover:underline">Yono promo codes page</a> for the latest working deals. Want to browse games? See our <a href="/games" class="text-yellow-400 hover:underline">full list of all Yono games</a>.
      </p>
    </div>

  </div>

  <Footer slot="footer" />
</BaseLayout>
