---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { apps } from '../../data/apps';

const categories = [...new Set(apps.map(a => a.category))];

const catColor: Record<string, string> = {
  Rummy:  'text-blue-400 bg-blue-500/10 border-blue-500/20',
  Slots:  'text-purple-400 bg-purple-500/10 border-purple-500/20',
  Spin:   'text-pink-400 bg-pink-500/10 border-pink-500/20',
  Arcade: 'text-green-400 bg-green-500/10 border-green-500/20',
  VIP:    'text-amber-400 bg-amber-400/10 border-amber-400/20',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yonolink.co' },
    { '@type': 'ListItem', position: 2, name: 'Download Apps', item: 'https://yonolink.co/app' },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: 'All Yono Game Apps — Download List',
  url: 'https://yonolink.co/app',
  numberOfItems: apps.length,
  itemListElement: apps.map((a, i) => ({
    '@type': 'ListItem', position: i + 1, name: a.name,
    url: `https://yonolink.co/app/${a.slug}`,
  })),
};
---

<BaseLayout
  title={`All Yono Game Apps — Download ${apps.length} Apps Free 2026`}
  description={`Download all ${apps.length} Yono game apps free for Android. Rummy, Slots, Spin, Arcade and VIP apps — all in one place with welcome bonus on first deposit.`}
  schema={[breadcrumbSchema, itemListSchema]}
>
  <Header slot="header" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center gap-1.5">
      <a href="/" class="hover:text-yellow-400 transition-colors">Home</a>
      <span>/</span>
      <span class="text-gray-300">Download Apps</span>
    </nav>

    <!-- Header -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 bg-yellow-400/10 border border-yellow-400/20 text-yellow-400 text-sm font-medium px-4 py-1.5 rounded-full mb-4">
        <Icon name="gamepad" class="w-4 h-4" /> {apps.length} Apps Available
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white mb-3">
        All Yono Game Apps — Download Free
      </h1>
      <p class="text-gray-400 text-lg max-w-3xl">
        Every Yono game app in one place — rummy, slots, spin wheels, 777 casino, arcade, VIP and more. Each app includes a free welcome bonus. Updated July 2026.
      </p>
    </div>

    <!-- ── Upcoming & New Releases ──────────────────────────────────────── -->
    <div class="mb-12">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-2xl font-black text-white">Upcoming And New Games</h2>
        <div class="flex items-center gap-2 text-sm text-gray-500">
          Sort:
          <span class="bg-gray-900 border border-gray-700 rounded-lg px-3 py-1 text-gray-300 text-xs">Latest added</span>
        </div>
      </div>

      <!-- Win Rummy upcoming card -->
      <div class="bg-gray-900/80 border border-gray-800 rounded-2xl overflow-hidden">

        <!-- Top bar: logo + countdown -->
        <div class="flex flex-col sm:flex-row items-center gap-5 p-5 border-b border-gray-800">
          <div class="w-20 h-20 shrink-0 rounded-2xl overflow-hidden border border-gray-700 bg-gray-800">
            <img src="/logos/win-rummy.png" alt="Win Rummy" class="w-full h-full object-contain p-1" loading="eager" />
          </div>
          <div class="flex gap-3 sm:gap-4">
            {[
              { id: 'ap-wr-days', label: 'DAYS' },
              { id: 'ap-wr-hrs',  label: 'HRS'  },
              { id: 'ap-wr-min',  label: 'MIN'  },
              { id: 'ap-wr-sec',  label: 'SEC'  },
            ].map(u => (
              <div class="flex flex-col items-center bg-gray-800 border border-gray-700 rounded-xl w-16 sm:w-20 py-2.5 px-1">
                <span id={u.id} class="font-mono font-black text-xl sm:text-2xl text-white tabular-nums leading-none mb-1">--</span>
                <span class="text-[10px] font-bold text-gray-500 tracking-widest">{u.label}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Body -->
        <div class="p-5">
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-green-500/15 text-green-400 border border-green-500/30">Coming Soon</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-gray-700/60 text-gray-300 border border-gray-600/40">Scheduled</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-500/15 text-blue-400 border border-blue-500/30">Rummy</span>
          </div>

          <h3 class="text-lg sm:text-xl font-black text-white mb-2">Win Rummy is joining the All Yono directory</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-3">
            Expected to launch at 7:00–8:00 AM IST on July 29, 2026. Welcome bonus ₹150–₹500 on first deposit. Minimum withdrawal ₹100 via UPI. Promo codes published here 3× daily from launch day.
          </p>
          <p class="text-gray-600 text-xs mb-5">Expected launch: July 29, 2026, 7:00–8:00 AM IST</p>

          <div class="flex flex-wrap gap-4 mb-5">
            <div class="flex items-center gap-2 text-sm">
              <Icon name="gift" class="w-4 h-4 text-yellow-400 shrink-0" />
              <span class="text-gray-300"><span class="font-semibold text-white">Welcome bonus:</span> ₹150–₹500</span>
            </div>
            <div class="flex items-center gap-2 text-sm">
              <Icon name="currency" class="w-4 h-4 text-yellow-400 shrink-0" />
              <span class="text-gray-300"><span class="font-semibold text-white">Min. Withdrawal:</span> ₹100</span>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/promo-codes" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl border border-green-500/40 text-green-400 text-sm font-bold hover:bg-green-500/10 transition-colors">
              <Icon name="gift" class="w-4 h-4" /> Get Promo Code on Launch
            </a>
            <a href="/app/win-rummy" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-gray-800 border border-gray-700 text-white text-sm font-bold hover:bg-gray-700 transition-colors">
              View Details
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Category filter -->
    <div class="flex flex-wrap gap-2 mb-8">
      <button class="app-filter-btn px-4 py-2 rounded-full text-sm font-medium bg-yellow-400 text-gray-950" data-cat="all">
        All Apps ({apps.length})
      </button>
      {categories.map(cat => (
        <button
          class="app-filter-btn px-4 py-2 rounded-full text-sm font-medium bg-gray-800 text-gray-300 hover:bg-gray-700 transition-colors"
          data-cat={cat}
        >
          {cat} ({apps.filter(a => a.category === cat).length})
        </button>
      ))}
    </div>

    <!-- Apps grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4" id="apps-grid">
      {apps.map(app => {
        const cc = catColor[app.category] ?? catColor['Slots'];
        return (
          <div class="app-card" data-cat={app.category}>
            <a href={`/app/${app.slug}`} class="group block bg-gray-900 border border-gray-800 rounded-2xl p-4 hover:border-yellow-400/40 transition-all text-center">
              <!-- Logo -->
              <div class="w-16 h-16 mx-auto rounded-xl overflow-hidden bg-gray-800 flex items-center justify-center mb-3 border border-gray-700 group-hover:border-yellow-400/30 transition-colors">
                <img src={app.logo} alt={`${app.name} logo`} class="w-full h-full object-contain p-1" loading="lazy" />
              </div>
              <!-- Name -->
              <div class="text-xs font-bold text-white group-hover:text-yellow-400 transition-colors leading-tight mb-1.5 line-clamp-2">
                {app.name}
              </div>
              <!-- Category badge -->
              <span class={`inline-block text-xs font-medium px-2 py-0.5 rounded-full border ${cc} mb-2`}>
                {app.category}
              </span>
              <!-- Rating -->
              <div class="flex items-center justify-center gap-0.5">
                <svg class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <span class="text-xs text-gray-400">{app.rating}</span>
              </div>
            </a>
          </div>
        );
      })}
    </div>

    <!-- SEO content -->
    <div class="max-w-3xl border-t border-gray-800 pt-12 mt-12">
      <h2 class="text-xl font-black text-white mb-4">About All Yono Game Apps</h2>
      <p class="text-gray-400 text-sm leading-relaxed mb-3">
        This page lists every app in the Yono gaming universe — from classic 13-card rummy to modern slot machines, lucky spin wheels, 777 casino games, bingo halls, and VIP platforms. All apps are available as free Android APK downloads with no hidden subscription fees.
      </p>
      <p class="text-gray-400 text-sm leading-relaxed">
        Each app page includes a full review, step-by-step download guide, key features, and a working welcome bonus code. For the latest promo codes, visit our <a href="/promo-codes" class="text-yellow-400 hover:underline">Yono promo codes page</a>.
      </p>
    </div>

  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // ── Win Rummy countdown — launches 2026-07-29 07:00 IST ─────────────────
  (function () {
    const launch = new Date('2026-07-29T07:00:00+05:30').getTime();
    const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
    const dEl = document.getElementById('ap-wr-days');
    const hEl = document.getElementById('ap-wr-hrs');
    const mEl = document.getElementById('ap-wr-min');
    const sEl = document.getElementById('ap-wr-sec');
    function tick() {
      const diff = launch - Date.now();
      if (diff <= 0) { [dEl,hEl,mEl,sEl].forEach(e => { if(e) e.textContent='00'; }); return; }
      if (dEl) dEl.textContent = pad(diff / 86400000);
      if (hEl) hEl.textContent = pad((diff % 86400000) / 3600000);
      if (mEl) mEl.textContent = pad((diff % 3600000) / 60000);
      if (sEl) sEl.textContent = pad((diff % 60000) / 1000);
      setTimeout(tick, 1000);
    }
    tick();
  })();

  // ── App filter ────────────────────────────────────────────────────────────
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.app-filter-btn');
  const appCards = document.querySelectorAll<HTMLElement>('.app-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-yellow-400', 'text-gray-950');
        b.classList.add('bg-gray-800', 'text-gray-300');
      });
      btn.classList.add('bg-yellow-400', 'text-gray-950');
      btn.classList.remove('bg-gray-800', 'text-gray-300');
      const cat = btn.dataset.cat;
      appCards.forEach(c => { c.style.display = (cat === 'all' || c.dataset.cat === cat) ? '' : 'none'; });
    });
  });
</script>
