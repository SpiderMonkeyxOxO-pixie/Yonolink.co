---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { apps, appsBySlug } from '../../data/apps';

export function getStaticPaths() {
  return apps.map(app => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const { name, slug, logo, category, tagline, description, rating, downloads, size, minDeposit, bonus, features, downloadUrl, faqs, suggestedApps } = app;

const stars = Math.round(rating);

// Category colour
const catColor: Record<string, { badge: string; glow: string }> = {
  Rummy:  { badge: 'text-blue-400 bg-blue-500/10 border-blue-500/20',      glow: 'from-blue-600/20 to-transparent'   },
  Slots:  { badge: 'text-purple-400 bg-purple-500/10 border-purple-500/20', glow: 'from-purple-600/20 to-transparent' },
  Spin:   { badge: 'text-pink-400 bg-pink-500/10 border-pink-500/20',       glow: 'from-pink-600/20 to-transparent'   },
  Arcade: { badge: 'text-green-400 bg-green-500/10 border-green-500/20',    glow: 'from-green-600/20 to-transparent'  },
  VIP:    { badge: 'text-amber-400 bg-amber-400/10 border-amber-400/20',    glow: 'from-amber-500/20 to-transparent'  },
};
const cc = catColor[category] ?? catColor['Slots'];

// Similar games — suggested + same-category extras, up to 9
const suggestedList = suggestedApps.map(s => appsBySlug[s]).filter(Boolean);
const sameCat = apps.filter(a => a.category === category && a.slug !== slug && !suggestedApps.includes(a.slug));
const similarApps = [...suggestedList, ...sameCat].slice(0, 9);

// Schemas
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://yonolink.co' },
    { '@type': 'ListItem', position: 2, name: 'All Yono Apps', item: 'https://yonolink.co/app' },
    { '@type': 'ListItem', position: 3, name: name, item: `https://yonolink.co/app/${slug}` },
  ],
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Android',
  url: `https://yonolink.co/app/${slug}`,
  image: `https://yonolink.co${logo}`,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: rating,
    bestRating: 5,
    worstRating: 1,
    ratingCount: 10000,
  },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR', availability: 'https://schema.org/InStock' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title={`${name} Download APK — Bonus, Review & Guide 2026`}
  description={`Download ${name} free on Android. ${tagline}. Claim ${bonus} on your first deposit. Min deposit ₹100.`}
  schema={[breadcrumbSchema, appSchema, faqSchema]}
>
  <Header slot="header" />

  <!-- ── HERO BANNER ───────────────────────────────────────────────────────── -->
  <div class="relative border-b border-gray-800 overflow-hidden">
    <!-- Background image -->
    <img src="/images/bgversion2.webp" alt="" class="absolute inset-0 w-full h-full object-cover object-center" aria-hidden="true" />
    <!-- Dark overlay so text stays readable -->
    <div class="absolute inset-0 bg-[#05070A]/80 pointer-events-none"></div>
    <!-- Category colour glow on top -->
    <div class={`absolute inset-0 bg-gradient-to-br ${cc.glow} opacity-40 pointer-events-none`}></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-10">

      <!-- Breadcrumb -->
      <nav class="text-xs text-gray-500 mb-6 flex items-center gap-1.5 flex-wrap">
        <a href="/" class="hover:text-yellow-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/app" class="hover:text-yellow-400 transition-colors">All Yono Apps</a>
        <span>/</span>
        <span class="text-gray-400">{name}</span>
      </nav>

      <!-- App hero content — mobile: centered column | lg: logo left + info right -->
      <div class="flex flex-col lg:flex-row lg:items-start gap-6 lg:gap-10">

        <!-- Logo — centered on mobile, left on desktop -->
        <div class="flex flex-col items-center lg:items-start lg:shrink-0">
          <!-- Running glow ring -->
          <div class="logo-glow-ring w-28 h-28 lg:w-36 lg:h-36 shrink-0">
            <div class="w-full h-full rounded-[14px] overflow-hidden bg-gray-800 flex items-center justify-center">
              <img src={logo} alt={`${name} logo`} class="w-full h-full object-contain p-1.5" loading="eager" />
            </div>
          </div>
        </div>

        <!-- Info block -->
        <div class="flex-1 min-w-0 flex flex-col items-center text-center lg:items-start lg:text-left">

          <!-- Category badge -->
          <span class={`inline-flex items-center text-xs font-bold px-3 py-1 rounded-full border mb-3 ${cc.badge}`}>
            {category} Game
          </span>

          <!-- App name -->
          <h1 class="text-3xl sm:text-4xl font-black text-white mb-2 leading-tight">{name}</h1>
          <p class="text-gray-400 text-sm mb-5 max-w-md">{tagline}</p>

          <!-- Rating row -->
          <div class="flex items-center justify-center lg:justify-start gap-2 mb-5 flex-wrap">
            <div class="flex items-center gap-0.5">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class={`w-5 h-5 ${i < stars ? 'text-yellow-400' : 'text-gray-700'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <span class="text-white font-black text-base">{rating}<span class="text-gray-500 font-normal text-sm">/5</span></span>
            <span class="text-gray-600 text-xs">·</span>
            <span class="text-gray-400 text-sm">{downloads} downloads</span>
          </div>

          <!-- Bonus chips row -->
          <div class="flex flex-wrap justify-center lg:justify-start gap-2 mb-6">
            <span class="flex items-center gap-1.5 bg-green-500/10 border border-green-500/20 text-green-400 text-xs font-bold px-3 py-1.5 rounded-full">
              <Icon name="gift" class="w-3.5 h-3.5" />
              {bonus}
            </span>
            <span class="flex items-center gap-1.5 bg-gray-800 border border-gray-700 text-gray-300 text-xs font-medium px-3 py-1.5 rounded-full">
              Min. Deposit: {minDeposit}
            </span>
            <span class="flex items-center gap-1.5 bg-gray-800 border border-gray-700 text-gray-300 text-xs font-medium px-3 py-1.5 rounded-full">
              Free APK
            </span>
          </div>

          <!-- CTA buttons — stack on mobile, side-by-side on lg -->
          <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto">
            <a
              href={downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 bg-gradient-to-r from-yellow-400 to-orange-500 text-gray-950 font-black px-8 py-3.5 rounded-xl hover:opacity-90 transition-opacity text-base w-full sm:w-auto"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
              Download Free
            </a>
            <a
              href="/promo-codes"
              class="flex items-center justify-center gap-2 bg-gray-800 border border-gray-700 text-white font-bold px-8 py-3.5 rounded-xl hover:bg-gray-700 transition-colors text-base w-full sm:w-auto"
            >
              <Icon name="tag" class="w-4 h-4 text-yellow-400" />
              Get Promo Codes
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── MAIN CONTENT ────────────────────────────────────────────────────────── -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">

      <!-- ── LEFT: ARTICLE CONTENT ──────────────────────────────────────────── -->
      <div class="lg:col-span-2 space-y-8">

        <!-- App Info Table -->
        <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
          <div class="px-5 py-3.5 border-b border-gray-800 flex items-center gap-2">
            <Icon name="sparkles" class="w-4 h-4 text-yellow-400" />
            <h2 class="font-black text-white text-sm">App Information</h2>
          </div>
          <dl class="divide-y divide-gray-800">
            {[
              { label: 'App Name',     value: name,         plain: true  },
              { label: 'Category',     value: category + ' Game', plain: true },
              { label: 'Version',      value: 'Latest 2026', plain: true  },
              { label: 'Size',         value: size,         plain: true  },
              { label: 'Downloads',    value: downloads,    plain: true  },
              { label: 'Rating',       value: `${rating}/5 ★`, star: true },
              { label: 'Min. Deposit', value: minDeposit,   plain: true  },
              { label: 'Welcome Bonus',value: bonus,        green: true  },
              { label: 'Platform',     value: 'android',   android: true},
              { label: 'Withdrawal',   value: 'UPI — Instant', plain: true },
            ].map(row => (
              <div class="flex items-center justify-between px-5 py-3 text-sm gap-4">
                <dt class="text-gray-500 shrink-0">{row.label}</dt>
                {row.android ? (
                  <dd class="flex items-center gap-1.5 text-green-400 font-medium">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.523 15.341a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0m-9.546 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0M2.895 8.04l-1.6-2.77a.374.374 0 0 1 .648-.375l1.619 2.804A10.77 10.77 0 0 1 7.5 6.554a10.77 10.77 0 0 1 4.5-.978c1.586 0 3.09.34 4.438.946l1.619-2.804a.374.374 0 0 1 .648.374l-1.6 2.77A10.513 10.513 0 0 1 22.5 16.5H1.5a10.513 10.513 0 0 1 1.395-8.46"/></svg>
                    Android
                  </dd>
                ) : row.green ? (
                  <dd class="text-green-400 font-bold">{row.value}</dd>
                ) : row.star ? (
                  <dd class="text-yellow-400 font-bold">{row.value}</dd>
                ) : (
                  <dd class="text-white font-medium text-right">{row.value}</dd>
                )}
              </div>
            ))}
          </dl>
        </div>

        <!-- About -->
        <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6">
          <h2 class="text-lg font-black text-white mb-3 flex items-center gap-2">
            <Icon name="newspaper" class="w-5 h-5 text-yellow-400" />
            About {name}
          </h2>
          <p class="text-gray-400 leading-relaxed text-sm">{description}</p>
        </div>

        <!-- Key Features -->
        <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6">
          <h2 class="text-lg font-black text-white mb-4 flex items-center gap-2">
            <Icon name="sparkles" class="w-5 h-5 text-yellow-400" />
            Key Features
          </h2>
          <ul class="space-y-3">
            {features.map(f => (
              <li class="flex items-start gap-3 text-sm text-gray-400">
                <span class="mt-0.5 shrink-0 w-5 h-5 rounded-full bg-yellow-400/10 border border-yellow-400/20 flex items-center justify-center">
                  <Icon name="check" class="w-3 h-3 text-yellow-400" />
                </span>
                {f}
              </li>
            ))}
          </ul>
        </div>

        <!-- How to Download -->
        <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6">
          <h2 class="text-lg font-black text-white mb-5 flex items-center gap-2">
            <svg class="w-5 h-5 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
            How to Download {name} APK
          </h2>
          <ol class="space-y-4">
            {[
              { step: 'Tap the Download Free button above', note: '' },
              { step: 'Wait for the APK file to download to your Android phone', note: '' },
              { step: 'Go to Settings → Security → Enable Unknown Sources (one-time setup)', note: 'On Android 8+, allow your browser to install apps when prompted' },
              { step: 'Open the downloaded APK file and tap Install', note: '' },
              { step: `Register with your mobile number and complete OTP verification`, note: '' },
              { step: `Go to Wallet → Promo Code, enter your welcome code, and claim your ${bonus}`, note: 'Get the code from our Promo Codes page. Minimum deposit ₹100 required.' },
            ].map((item, i) => (
              <li class="flex gap-4">
                <span class="shrink-0 w-7 h-7 rounded-full bg-yellow-400/10 border border-yellow-400/30 text-yellow-400 text-xs font-black flex items-center justify-center">{i + 1}</span>
                <div>
                  <p class="text-sm text-white font-medium">{item.step}</p>
                  {item.note && <p class="text-xs text-gray-500 mt-0.5">{item.note}</p>}
                </div>
              </li>
            ))}
          </ol>

          <!-- Pro tip box -->
          <div class="mt-5 flex items-start gap-3 p-4 bg-yellow-400/5 border border-yellow-400/20 rounded-xl">
            <Icon name="lightbulb" class="w-5 h-5 text-yellow-400 shrink-0 mt-0.5" />
            <div>
              <p class="text-xs font-bold text-yellow-400 mb-0.5">Pro Tip</p>
              <p class="text-xs text-gray-400">Always download {name} from YonoLink.co — never from unofficial APK mirror sites. Official source ensures the file is unmodified and safe.</p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        <div>
          <h2 class="text-xl font-black text-white mb-4">Frequently Asked Questions</h2>
          <div class="space-y-3">
            {faqs.map((faq, i) => (
              <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden group">
                <button class="faq-btn w-full flex items-center justify-between gap-3 px-5 py-4 text-left" data-idx={i}>
                  <span class="text-sm font-semibold text-white">{faq.q}</span>
                  <svg class="faq-icon w-5 h-5 text-gray-500 shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                  </svg>
                </button>
                <div class="faq-answer hidden px-5 pb-5 text-sm text-gray-400 leading-relaxed border-t border-gray-800 pt-4">
                  {faq.a}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- ── SIDEBAR ──────────────────────────────────────────────────────────── -->
      <aside class="space-y-5">
        <div class="lg:sticky lg:top-24 space-y-5">

          <!-- Download CTA card -->
          <div class="bg-gradient-to-br from-yellow-400/10 to-orange-500/10 border border-yellow-400/20 rounded-2xl p-5 text-center">
            <div class="w-16 h-16 mx-auto rounded-2xl overflow-hidden bg-gray-800 border border-gray-700 mb-3">
              <img src={logo} alt={name} class="w-full h-full object-contain p-1" loading="lazy" />
            </div>
            <div class="text-white font-black text-base mb-0.5">{name}</div>
            <div class="text-green-400 font-bold text-sm mb-1">{bonus}</div>
            <div class="text-gray-500 text-xs mb-4">Min. Deposit: {minDeposit}</div>
            <a href={downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="block w-full bg-gradient-to-r from-yellow-400 to-orange-500 text-gray-950 font-black py-3 rounded-xl hover:opacity-90 transition-opacity text-sm mb-2">
              Download Free
            </a>
            <a href="/promo-codes"
              class="block w-full bg-gray-800 border border-gray-700 text-white font-semibold py-2.5 rounded-xl hover:bg-gray-700 transition-colors text-sm">
              Get Promo Codes
            </a>
          </div>

          <!-- Promo code box -->
          <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5 text-center">
            <Icon name="gift" class="w-7 h-7 text-yellow-400 mx-auto mb-2" />
            <p class="text-white font-bold text-sm mb-1">Welcome Bonus Available</p>
            <p class="text-xs text-gray-400 mb-4">New users get a welcome bonus on first deposit. Get the code before you register.</p>
            <a href="/promo-codes" class="block bg-gradient-to-r from-yellow-400 to-orange-500 text-gray-950 font-black text-sm py-2.5 rounded-xl hover:opacity-90 transition-opacity">
              Get Bonus Code
            </a>
          </div>

          <!-- Quick stats -->
          <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5">
            <h3 class="font-bold text-white text-sm mb-4">Quick Stats</h3>
            <dl class="space-y-2.5 text-sm">
              {[
                { label: 'Rating',     value: `${rating} / 5`  },
                { label: 'Downloads',  value: downloads         },
                { label: 'Size',       value: size              },
                { label: 'Min Deposit',value: minDeposit        },
                { label: 'Platform',   value: 'Android'         },
              ].map(row => (
                <div class="flex justify-between items-center">
                  <dt class="text-gray-500">{row.label}</dt>
                  <dd class="text-white font-medium">{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- Back link -->
          <a href="/app" class="flex items-center gap-2 justify-center text-gray-500 hover:text-white text-sm transition-colors py-1">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
            All download apps
          </a>
        </div>
      </aside>
    </div>

    <!-- ── SIMILAR GAMES SECTION ─────────────────────────────────────────────── -->
    {similarApps.length > 0 && (
      <div class="mt-14 pt-10 border-t border-gray-800">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-xl font-black text-white">Similar {category} Games</h2>
            <p class="text-gray-500 text-sm mt-1">More apps in the {category} category</p>
          </div>
          <a href="/games" class="text-yellow-400 text-sm font-semibold hover:text-yellow-300 transition-colors">View All →</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {similarApps.map(s => (
            <a href={`/app/${s.slug}`}
              class="group flex items-center gap-4 bg-gray-900 border border-gray-800 rounded-2xl p-4 hover:border-yellow-400/30 transition-all">
              <!-- Logo -->
              <div class="w-16 h-16 shrink-0 rounded-xl overflow-hidden bg-gray-800 border border-gray-700 flex items-center justify-center group-hover:border-yellow-400/30 transition-colors">
                <img src={s.logo} alt={s.name} class="w-full h-full object-contain p-1" loading="lazy" />
              </div>
              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div class="text-sm font-black text-white group-hover:text-yellow-400 transition-colors truncate mb-0.5">{s.name}</div>
                <div class="text-xs text-gray-500 mb-1.5">{s.category} Game</div>
                <!-- Stars -->
                <div class="flex items-center gap-1">
                  {Array.from({ length: 5 }).map((_, i) => (
                    <svg class={`w-3 h-3 ${i < Math.round(s.rating) ? 'text-yellow-400' : 'text-gray-700'}`} fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                  <span class="text-[11px] text-gray-400 ml-1 font-medium">{s.rating}</span>
                </div>
              </div>
              <!-- Arrow -->
              <Icon name="arrow-right" class="w-4 h-4 text-gray-700 group-hover:text-yellow-400 transition-colors shrink-0" />
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <Footer slot="footer" />
</BaseLayout>

<script>
  document.querySelectorAll('.faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const answer = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;
      const open = !answer.classList.contains('hidden');
      answer.classList.toggle('hidden', open);
      icon.style.transform = open ? '' : 'rotate(180deg)';
    });
  });
</script>

<style>
  @property --logo-a {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes logo-glow-spin {
    to { --logo-a: 360deg; }
  }

  .logo-glow-ring {
    position: relative;
    border-radius: 1rem;
    padding: 2.5px;
    background: conic-gradient(
      from var(--logo-a),
      transparent 0deg,
      rgba(250, 204, 21, 0.95) 28deg,
      rgba(249, 115, 22, 0.80) 52deg,
      rgba(168, 85, 247, 0.60) 78deg,
      transparent 108deg
    );
    animation: logo-glow-spin 2.5s linear infinite;
    box-shadow:
      0 0 22px rgba(250, 204, 21, 0.18),
      0 6px 32px rgba(0, 0, 0, 0.65);
  }
</style>
