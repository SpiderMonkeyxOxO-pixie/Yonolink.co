  <script>
    // ── Agent counter animation ──
    const counterEl = document.getElementById('agent-counter');
    if (counterEl) {
      const target = parseInt(counterEl.dataset.target ?? '0', 10);
      let current = 0;
      const duration = 2400;
      let start: number | null = null;
      const fmt = (n: number) => n.toLocaleString('en-US');
      const easeOutExpo = (t: number) => t === 1 ? 1 : 1 - Math.pow(2, -10 * t);

      const liveIncrement = () => {
        current += Math.random() < 0.5 ? 1 : 2;
        counterEl.textContent = fmt(current);
        setTimeout(liveIncrement, 5000 + Math.random() * 7000);
      };

      const tick = (timestamp: number) => {
        if (!start) start = timestamp;
        const progress = Math.min((timestamp - start) / duration, 1);
        current = Math.floor(easeOutExpo(progress) * target);
        counterEl.textContent = fmt(current);
        if (progress < 1) requestAnimationFrame(tick);
        else {
          current = target;
          counterEl.textContent = fmt(current);
          setTimeout(liveIncrement, 5000 + Math.random() * 5000);
        }
      };

      const observer = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting) {
          requestAnimationFrame(tick);
          observer.disconnect();
        }
      }, { threshold: 0.3 });

      observer.observe(counterEl);
    }

    // ── Add another channel ──
    const addBtn = document.getElementById('add-channel-btn');
    const container = document.getElementById('channels-container');
    let channelCount = 1;

    addBtn?.addEventListener('click', () => {
      channelCount++;
      const wrapper = document.createElement('div');
      wrapper.className = 'relative';

      const input = document.createElement('input');
      input.type = 'text';
      input.name = 'channels[]';
      input.placeholder = 'Telegram channel, Instagram page, or community URL';
      input.className = 'agent-input w-full glass border border-white/10 rounded-xl px-4 py-3 pr-10 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-yellow-400/40 focus:bg-yellow-400/5 transition-all duration-200 bg-transparent';

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'absolute right-3 top-1/2 -translate-y-1/2 text-gray-600 hover:text-red-400 transition-colors text-lg leading-none';
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', () => wrapper.remove());

      wrapper.appendChild(input);
      wrapper.appendChild(removeBtn);
      container?.appendChild(wrapper);
      input.focus();
    });

    // ── Form submission — builds Telegram message and opens chat ──
    const form = document.getElementById('agent-form') as HTMLFormElement | null;
    const successEl = document.getElementById('agent-success');
    const submitBtn = document.getElementById('agent-submit');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const telegram = (form.querySelector('[name="telegram"]') as HTMLInputElement)?.value.trim();
      const channel  = (form.querySelector('[name="tg-channel"]') as HTMLInputElement)?.value.trim();
      const message  = (form.querySelector('[name="message"]') as HTMLTextAreaElement)?.value.trim();
      const extras   = [...(form.querySelectorAll('[name="channels[]"]') ?? [])]
        .map(el => (el as HTMLInputElement).value.trim()).filter(Boolean);

      if (!telegram) {
        (form.querySelector('[name="telegram"]') as HTMLInputElement)?.focus();
        return;
      }

      let text = `🤝 Yonolink Agent Application\n\n`;
      text += `Telegram: @${telegram}\n`;
      if (channel) text += `Channel: ${channel}\n`;
      if (extras.length) text += `Other: ${extras.join(', ')}\n`;
      if (message) text += `\nMessage: ${message}`;

      if (submitBtn) submitBtn.setAttribute('disabled', 'true');
      window.open(`https://t.me/Lakshymi?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');

      setTimeout(() => {
        form.querySelectorAll('.agent-input, #add-channel-btn, #agent-submit').forEach(el => {
          (el as HTMLElement).style.display = 'none';
        });
        successEl?.classList.remove('hidden');
      }, 400);
    });
  </script>

