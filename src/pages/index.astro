---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import GameCard from '../components/GameCard.astro';
import { getCollection } from 'astro:content';
import { apps } from '../data/apps';

const allPosts  = await getCollection('blog');

const featuredPosts  = allPosts.filter(p => p.data.featured).slice(0, 3);

// Featured game gallery — 4 flagship apps shown with full card metadata
const featuredGameSlugs = ['dhan-game', 'max-rummy', 'yono-rummy', 'yono-games'];
const featuredNewSlugs  = new Set(['dhan-game', 'max-rummy']);

// Top apps — featured order first, then curated picks
const topAppSlugs = [
  'dhan-game', 'max-rummy', 'yono-rummy', 'yono-games',
  'yono-777', 'yono-arcade', 'yono-slots', 'top-rummy',
];
import { appsBySlug } from '../data/apps';
const topApps = topAppSlugs.map(s => appsBySlug[s]).filter(Boolean);
const featuredGames = featuredGameSlugs.map(s => appsBySlug[s]).filter(Boolean);

// Per-category card backgrounds for featured & listing cards
const catCardBg: Record<string, { grad: string; glow: string }> = {
  Rummy:  { grad: 'from-blue-900/70 via-blue-950/40 to-gray-900',    glow: 'bg-blue-500/25'   },
  Slots:  { grad: 'from-purple-900/70 via-purple-950/40 to-gray-900',glow: 'bg-purple-500/25' },
  Spin:   { grad: 'from-pink-900/70 via-pink-950/40 to-gray-900',    glow: 'bg-pink-500/25'   },
  Arcade: { grad: 'from-green-900/70 via-green-950/40 to-gray-900',  glow: 'bg-green-500/25'  },
  VIP:    { grad: 'from-yellow-900/70 via-yellow-950/40 to-gray-900',glow: 'bg-yellow-500/25' },
};

// Category meta
const catMeta: Record<string, { color: string; border: string; desc: string; icon: string }> = {
  Rummy:  { color: 'from-blue-600/20 to-blue-500/5',    border: 'border-blue-500/20',   desc: '13-card rummy for real cash',    icon: 'gamepad'  },
  Spin:   { color: 'from-pink-600/20 to-pink-500/5',    border: 'border-pink-500/20',   desc: 'Lucky spin wheels & prizes',     icon: 'sparkles' },
  Slots:  { color: 'from-purple-600/20 to-purple-500/5',border: 'border-purple-500/20', desc: 'Slots, 777 & jackpot games',     icon: 'sparkles' },
  Arcade: { color: 'from-green-600/20 to-green-500/5',  border: 'border-green-500/20',  desc: 'Arcade & multi-game platforms',  icon: 'gamepad'  },
  VIP:    { color: 'from-amber-500/20 to-amber-400/5',  border: 'border-amber-400/20',  desc: 'Premium VIP platforms',          icon: 'sparkles' },
};

const categories = [...new Set(apps.map(a => a.category))];

const seoTitle   = `All Yono Game — Download ${apps.length} Apps & Promo Codes 2026`;
const monthYear  = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
const seoDesc    = `Your complete guide to all Yono game — ${apps.length} apps including Rummy, Slots, Spin, Arcade and VIP. Verified promo codes, download links and expert tips. Updated ${monthYear}.`;

const faqs = [
  {
    q: 'What is All Yono Game?',
    a: 'All Yono Game refers to the complete collection of real-cash gaming apps available in the Yono platform ecosystem — including Rummy, Slots, Spin, Arcade, and VIP apps. YonoLink.co covers all Yono games in one place.',
  },
  {
    q: 'How many games are available on Yono?',
    a: 'The Yono gaming ecosystem currently covers 52 apps across 5 categories: Rummy, Slots, Spin, Arcade, and VIP. New apps are added regularly.',
  },
  {
    q: 'Which All Yono Game is best for winning real money?',
    a: 'Yono Rummy, Boss Rummy, and Top Rummy are the most skill-based and offer the highest consistent payouts. For casual play, Spin 777 and Slot Spin offer easy wins. Visit our Promo Codes page to claim your welcome bonus before your first deposit.',
  },
  {
    q: 'Are Yono promo codes free to use?',
    a: 'Yes — all promo codes listed on YonoLink.co are completely free. Copy the code, open your Yono app, go to Wallet → Promo Codes, paste it and tap Apply. The bonus is credited instantly to your account.',
  },
  {
    q: 'How do I download Yono games on Android?',
    a: 'Each Yono game is a standalone APK download. Visit the app\'s download page on YonoLink.co, tap "Download Free", allow Unknown Sources in your Android settings, and install the APK. No Play Store required.',
  },
  {
    q: 'Is all Yono game safe and legal in India?',
    a: 'Yono skill-based games like Rummy are classified as legal in most Indian states. All apps use 256-bit SSL encryption and RBI-approved payment gateways. Always check the laws of your specific state before playing for real cash.',
  },
  {
    q: 'What is the minimum deposit to start playing Yono games?',
    a: 'All Yono apps have a minimum deposit of ₹100. New users can claim a welcome bonus on their first deposit — visit our Promo Codes page to get the current code before you deposit.',
  },
  {
    q: 'Can I play multiple Yono games on the same account?',
    a: 'Each Yono app is a separate platform requiring its own account. A welcome bonus is available on each new app you register on — check our Promo Codes page for the current codes before registering.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'All Yono Game — Complete App List 2026',
  url: 'https://yonolink.co/games',
  numberOfItems: apps.length,
  itemListElement: apps.slice(0, 10).map((a, i) => ({
    '@type': 'ListItem', position: i + 1, name: a.name,
    url: `https://yonolink.co/app/${a.slug}`,
  })),
};
---

<BaseLayout title={seoTitle} description={seoDesc} schema={[faqSchema, itemListSchema]}>
  <Header slot="header" />

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="relative min-h-[88vh] flex items-center overflow-hidden hero-mesh py-16 sm:py-24">
    <!-- Hero background image -->
    <div class="absolute inset-0 pointer-events-none">
      <img src="/herobg.jpg" alt="" class="w-full h-full object-cover object-center opacity-20" aria-hidden="true" />
      <!-- Dark overlay so text stays readable -->
      <div class="absolute inset-0 bg-[#05070A]/60"></div>
    </div>
    <!-- Animated background blobs -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute -top-48 left-1/2 -translate-x-1/2 w-[1000px] h-[700px] bg-yellow-400/8 rounded-full blur-[120px] animate-float-slow"></div>
      <div class="absolute top-1/3 -left-48 w-[500px] h-[500px] bg-violet-600/7 rounded-full blur-[100px] animate-float-d1"></div>
      <div class="absolute top-1/4 -right-40 w-[400px] h-[400px] bg-orange-500/6 rounded-full blur-[90px] animate-float-d2"></div>
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-yellow-400/4 rounded-full blur-[80px]"></div>
      <!-- Dot grid overlay -->
      <div class="absolute inset-0 dot-grid opacity-[0.035]"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center w-full">

      <!-- Live badge -->
      <div class="inline-flex items-center gap-2.5 glass-gold border border-yellow-400/20 text-yellow-400 text-xs sm:text-sm font-bold px-5 py-2 rounded-full mb-8 shadow-glow-gold">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-yellow-400"></span>
        </span>
        India's #1 Guide to All Yono Game
      </div>

      <!-- Headline -->
      <h1 class="font-display font-black leading-[1.05] tracking-tight mb-6">
        <span class="block text-4xl sm:text-5xl lg:text-6xl text-white mb-0.5">All <span class="text-gold">Yono Game</span></span>
        <span class="block text-xl sm:text-2xl lg:text-3xl text-gray-400 font-bold mt-2">Download, Play &amp; Win Real Cash</span>
      </h1>

      <!-- Subtitle -->
      <p class="text-gray-400 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
        Complete guide to all <strong class="text-white font-bold">{apps.length}</strong> Yono games —
        Rummy, Slots, Spin, Arcade &amp; more. Verified promo codes and expert tips. Updated July 2026.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14 sm:mb-16">
        <a
          href="/games"
          class="btn-shimmer btn-glow w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-yellow-400 via-amber-400 to-orange-500 text-gray-950 font-black text-base px-8 py-4 rounded-2xl"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/>
          </svg>
          Browse All {apps.length} Apps
          <span class="text-xs bg-gray-950/20 rounded-full px-2.5 py-0.5 font-bold">Free</span>
        </a>
        <a
          href="/promo-codes"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 glass border border-yellow-400/20 hover:border-yellow-400/40 text-white font-bold text-base px-8 py-4 rounded-2xl transition-all duration-200 group"
        >
          <Icon name="gift" class="w-5 h-5 text-yellow-400 group-hover:animate-float shrink-0" />
          Get Free Promo Codes
        </a>
      </div>

      <!-- Stats — glass cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 max-w-xl mx-auto">
        {[
          { value: apps.length + '+', label: 'Game Apps'       },
          { value: categories.length.toString(), label: 'Categories' },
          { value: '₹500',            label: 'Max Bonus'       },
          { value: '100%',            label: 'Free Download'   },
        ].map(s => (
          <div class="glow-card glow-card-static glass border border-white/5 rounded-2xl px-3 py-4 text-center">
            <div class="text-2xl sm:text-3xl font-black text-gold mb-1">{s.value}</div>
            <div class="text-gray-500 text-xs font-medium">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── UPCOMING & NEW RELEASES ──────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
    <div class="flex items-center justify-between mb-5">
      <h2 class="font-display font-black text-xl sm:text-2xl text-white">Upcoming And New Games</h2>
      <div class="flex items-center gap-2 text-sm text-gray-500">
        Sort:
        <span class="bg-gray-900 border border-gray-700 rounded-lg px-3 py-1 text-gray-300 text-xs">Latest added</span>
      </div>
    </div>

    <div class="bg-gray-900/80 border border-gray-800 rounded-2xl p-5 flex flex-col sm:flex-row gap-5">
      <!-- Logo -->
      <div class="w-36 h-36 shrink-0 rounded-2xl overflow-hidden border border-gray-700">
        <img src="/logos/dhan-game.webp" alt="Dhan Game" class="w-full h-full object-cover" loading="eager" />
      </div>

      <!-- Content -->
      <div class="flex-1 min-w-0">
        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-3">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-orange-500/15 text-orange-400 border border-orange-500/25">Coming Soon</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-500/15 text-red-400 border border-red-500/25">Hot</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-500/15 text-green-400 border border-green-500/25">New</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-700/60 text-gray-300 border border-gray-600/40">Slots</span>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-700/60 text-gray-300 border border-gray-600/40">Upcoming</span>
        </div>

        <h3 class="text-xl font-black text-white mb-0.5">Dhan Game</h3>
        <p class="text-gray-400 text-sm mb-4">Slots Game</p>

        <div class="bg-gray-800/50 border border-gray-700/50 rounded-xl p-4 mb-4 space-y-2.5">
          <div class="flex items-center gap-2.5 text-sm">
            <Icon name="gift" class="w-4 h-4 text-yellow-400 shrink-0" />
            <span class="text-gray-300"><span class="font-semibold text-white">Welcome bonus:</span> ₹80 - ₹175</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm">
            <Icon name="currency" class="w-4 h-4 text-yellow-400 shrink-0" />
            <span class="text-gray-300"><span class="font-semibold text-white">Minimum Withdrawal:</span> ₹100</span>
          </div>
        </div>

        <div class="mb-4">
          <div class="inline-flex items-center gap-2 bg-gray-800 border border-gray-700 rounded-full px-4 py-2 text-sm text-white">
            <span class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse shrink-0"></span>
            Launches in: <span id="hp-dhan-countdown" class="font-mono font-bold text-yellow-400 ml-1 tabular-nums">--:--:--</span>
          </div>
        </div>

        <button id="hp-dhan-cta" disabled class="w-full sm:w-auto sm:min-w-[200px] bg-gradient-to-r from-orange-500 to-red-500 text-white font-black py-3 px-8 rounded-xl cursor-not-allowed text-sm">
          Coming Soon
        </button>
      </div>
    </div>
  </section>

  <script>
    // ── Dhan Game homepage countdown — launches 2026-07-23 08:00 IST ─────────
    (function () {
      const launchStart = new Date('2026-07-23T08:00:00+05:30').getTime();
      const launchEnd   = new Date('2026-07-23T09:00:00+05:30').getTime();
      const cdEl  = document.getElementById('hp-dhan-countdown');
      const ctaEl = document.getElementById('hp-dhan-cta') as HTMLButtonElement | null;
      const pad = (n: number) => String(n).padStart(2, '0');

      function activateCta() {
        if (!ctaEl) return;
        ctaEl.disabled = false;
        ctaEl.textContent = 'Download Now';
        ctaEl.classList.remove('cursor-not-allowed');
        ctaEl.classList.add('cursor-pointer', 'hover:opacity-90', 'transition-opacity');
      }

      function tick() {
        const now  = Date.now();
        const diff = launchStart - now;
        if (diff <= 0 && now < launchEnd) {
          if (cdEl) cdEl.textContent = 'LIVE NOW';
          activateCta();
          return;
        }
        if (now >= launchEnd) {
          if (cdEl) cdEl.textContent = 'Launched!';
          activateCta();
          return;
        }
        const h = Math.floor(diff / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        if (cdEl) cdEl.textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
        setTimeout(tick, 1000);
      }
      tick();
    })();
  </script>

  <!-- ── CATEGORY CAROUSEL ────────────────────────────────────────────────── -->
  <section class="py-8 sm:py-12 border-b border-white/5 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 text-center">
      <h2 class="font-display font-black text-xl sm:text-3xl text-white mb-1">Browse All Yono Game by Category</h2>
      <p class="text-gray-500 text-sm">{categories.length} categories — tap any to explore every app</p>
    </div>

    <div class="relative overflow-hidden">
      <!-- Fade edges -->
      <div class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-[#05070A] to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-[#05070A] to-transparent z-10 pointer-events-none"></div>

      <div class="cat-slider flex gap-4 py-3" style="width: max-content">
        {[...categories, ...categories].map(cat => {
          const meta = catMeta[cat] ?? catMeta['Slots'];
          const count = apps.filter(a => a.category === cat).length;
          return (
            <a
              href="/games"
              class={`glow-card cat-glow flex items-center gap-3 bg-gradient-to-br ${meta.color} rounded-2xl px-5 py-3.5 hover:scale-[1.03] transition-transform shrink-0 group`}
            >
              <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center shrink-0">
                <Icon name={meta.icon} class="w-4 h-4 text-white" />
              </div>
              <div>
                <div class="text-white font-bold text-sm leading-tight">{cat}</div>
                <div class="text-gray-400 text-xs">{count} apps</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <style>
    .cat-slider { animation: cat-slide 24s linear infinite; }
    .cat-slider:hover { animation-play-state: paused; }
    @keyframes cat-slide {
      0%   { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* ── Running glow border on category cards ── */
    @property --cat-a {
      syntax: '<angle>';
      initial-value: 0deg;
      inherits: false;
    }
    @keyframes cat-glow-run {
      to { --cat-a: 360deg; }
    }
    .cat-glow {
      box-shadow: 0 0 16px rgba(250,204,21,0.10), 0 4px 24px rgba(0,0,0,0.5);
    }
    .cat-glow::before {
      background: conic-gradient(
        from var(--cat-a),
        transparent 0deg,
        rgba(250,204,21,0.95) 28deg,
        rgba(249,115,22,0.80) 52deg,
        rgba(168,85,247,0.60) 78deg,
        transparent 108deg
      ) !important;
      background-size: 100% 100% !important;
      padding: 1.5px !important;
      opacity: 1 !important;
      animation: cat-glow-run 2.5s linear infinite !important;
    }
    .cat-glow:hover {
      box-shadow: 0 0 28px rgba(250,204,21,0.22), 0 8px 40px rgba(0,0,0,0.6);
    }
    .cat-glow:hover::before {
      animation-duration: 1.4s !important;
    }
  </style>

  <!-- ── FEATURED GAMES GALLERY ──────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="flex items-center justify-between mb-6 sm:mb-8">
      <div>
        <h2 class="font-display font-black text-xl sm:text-3xl text-white">Featured Yono Games</h2>
        <p class="text-gray-500 mt-1 text-sm">Flagship apps — highest rated, most downloaded</p>
      </div>
      <a href="/games" class="shrink-0 text-sm font-bold text-gold hover:underline transition-colors">
        View All →
      </a>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
      {featuredGames.map(app => (
        <GameCard
          title={app.name}
          slug={app.slug}
          description={app.tagline}
          category={app.category}
          rating={app.rating}
          tags={app.tags}
          image={app.logo}
          featured={featuredNewSlugs.has(app.slug)}
          href={`/app/${app.slug}`}
        />
      ))}
    </div>
  </section>

  <!-- ── TOP RATED APPS ────────────────────────────────────────────────────── -->
  <section class="border-y border-white/5 py-10 sm:py-16" style="background: linear-gradient(180deg, #0D1117 0%, #05070A 100%)">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-start sm:items-center justify-between mb-6 sm:mb-8 gap-3">
        <div>
          <h2 class="font-display font-black text-xl sm:text-3xl text-white leading-tight">Top Rated Yono Game Apps</h2>
          <p class="text-gray-500 mt-1 text-sm sm:text-base">Highest rated across all categories — July 2026</p>
        </div>
        <a href="/app" class="shrink-0 text-sm font-bold text-gold hover:underline whitespace-nowrap">
          View All →
        </a>
      </div>

      <div class="grid grid-cols-4 lg:grid-cols-8 gap-2 sm:gap-3">
        {topApps.map(app => (
          <a href={`/app/${app.slug}`} class="glow-card group glass border border-white/5 rounded-xl sm:rounded-2xl p-2 sm:p-3 text-center hover:border-yellow-400/20 transition-all">
            <div class="w-10 h-10 sm:w-14 sm:h-14 mx-auto rounded-xl overflow-hidden bg-white/5 border border-white/10 mb-1.5 sm:mb-2 group-hover:border-yellow-400/20 transition-colors">
              <img src={app.logo} alt={app.name} class="w-full h-full object-contain p-0.5" loading="lazy" />
            </div>
            <div class="text-[10px] sm:text-xs font-bold text-white group-hover:text-gold transition-colors leading-tight line-clamp-2 mb-1">{app.name}</div>
            <div class="flex items-center justify-center gap-0.5">
              <svg class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <span class="text-[10px] sm:text-xs text-gray-400">{app.rating}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-5">
        <a href="/app" class="text-sm font-bold text-gold hover:underline">View All {apps.length} Apps →</a>
      </div>
    </div>
  </section>

  <!-- ── HOW IT WORKS ──────────────────────────────────────────────────────── -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="text-center mb-6 sm:mb-10">
      <h2 class="font-display font-black text-2xl sm:text-3xl text-white mb-2">How to Start Playing All Yono Game</h2>
      <p class="text-gray-500">Get started in 3 steps — takes less than 5 minutes</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      {[
        {
          step: '01',
          title: 'Choose Your Yono Game',
          desc: 'Browse all Yono apps by category — Rummy, Slots, Spin, Arcade or VIP. Each app page has a full review, features list, and download guide.',
          cta: 'Browse Games',
          href: '/games',
          color: 'text-blue-400',
          border: 'border-blue-500/25',
          glow: 'bg-blue-500/10',
          badgeBg: 'bg-blue-500/10',
        },
        {
          step: '02',
          title: 'Download and Register',
