    const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab!;
        tabBtns.forEach(b => {
          b.classList.remove('bg-gradient-to-r', 'from-yellow-400', 'to-orange-500', 'text-gray-950', 'shadow-glow-gold');
          b.classList.add('glass', 'border', 'border-white/5', 'text-gray-400');
        });
        btn.classList.add('bg-gradient-to-r', 'from-yellow-400', 'to-orange-500', 'text-gray-950', 'shadow-glow-gold');
        btn.classList.remove('glass', 'border', 'border-white/5', 'text-gray-400');
        tabPanels.forEach(p => {
          p.id === `panel-${target}` ? p.classList.remove('hidden') : p.classList.add('hidden');
        });
      });
    });
  </script>

