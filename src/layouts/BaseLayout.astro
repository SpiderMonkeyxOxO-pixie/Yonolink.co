---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  keywords?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  image    = '/herobg.jpg',
  canonical,
  keywords = 'all yono game, yono games, yono rummy, yono slots, yono spin, yono promo codes, yono apk download, yono bonus india',
  schema,
  noindex  = false,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImage      = new URL(image, Astro.site).href;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'YonoLink.co',
  url: 'https://yonolink.co',
  description: 'Your #1 source for all Yono games, verified promo codes, and expert guides.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://yonolink.co/games?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#05070A" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  }
  <title>{title}</title>

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="YonoLink.co" />
  <meta property="og:locale"      content="en_IN" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />

  <!-- Favicon -->
  <link rel="icon"             type="image/x-icon" href="/favicon.ico" />
  <link rel="icon"             type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/logo.png" />

  <!-- Fonts — non-render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style"
    href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@400;500;600;700;800;900&display=swap" />
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@400;500;600;700;800;900&display=swap"
    media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Inter:wght@400;500;600;700;800;900&display=swap" />
  </noscript>

  <!-- JSON-LD: WebSite (always) -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <!-- JSON-LD: Page-specific -->
  {schema && (Array.isArray(schema) ? schema : [schema]).map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body class="bg-[#05070A] text-white font-sans min-h-screen flex flex-col antialiased" data-theme="yono">
  <slot name="header" />
  <main class="flex-1">
    <slot />
  </main>
  <slot name="footer" />
</body>
</html>
