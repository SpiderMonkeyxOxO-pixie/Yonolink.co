---
import '../styles/global.css';
import '../styles/fonts.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  keywords?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  image    = '/herobg.jpg',
  canonical,
  keywords = 'all yono game, yono games, yono rummy, yono slots, yono spin, yono promo codes, yono apk download, yono bonus india',
  schema,
  noindex  = false,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImage      = new URL(image, Astro.site).href;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'YonoLink.co',
  url: 'https://yonolink.co',
  description: 'Your #1 source for all Yono games, verified promo codes, and expert guides.',
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#05070A" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  }
  <title>{title}</title>

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:type"        content="website" />
  <meta property="og:site_name"   content="YonoLink.co" />
  <meta property="og:locale"      content="en_IN" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />

  <!-- Favicon -->
  <link rel="icon"             type="image/png" sizes="512x512" href="/logo.png" />
  <link rel="apple-touch-icon" href="/logo.png" />

  <!-- Fonts — self-hosted (see src/styles/fonts.css), eliminates the external
       fonts.googleapis.com/fonts.gstatic.com DNS+connection round-trip that
       a real mobile network pays even with font-display: swap. -->
  <link rel="preload" href="/fonts/inter-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/syne-800-normal.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Google Analytics -- the gtag.js library itself is loaded on
       idle/after-load so its scripting cost doesn't compete with the
       LCP paint; dataLayer queues calls immediately so the "js"/"config"
       timestamps stay accurate. -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-5KVS959BJ5');
    (function(){
      function loadGtag(){
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-5KVS959BJ5';
        document.head.appendChild(s);
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadGtag, { timeout: 3500 });
      } else {
        window.addEventListener('load', function(){ setTimeout(loadGtag, 1); });
      }
    })();
  </script>

  <!-- JSON-LD: WebSite (always) -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <!-- JSON-LD: Page-specific -->
  {schema && (Array.isArray(schema) ? schema : [schema]).map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body class="bg-[#05070A] text-white font-sans min-h-screen flex flex-col antialiased" data-theme="yono">
  <slot name="header" />
  <main class="flex-1">
    <slot />
  </main>
  <slot name="footer" />
</body>
</html>
